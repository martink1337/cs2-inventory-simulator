{
  "name": "@ianlucas/cs2-inventory-simulator",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "npx @ianlucas/deploy@latest",
    "dev": "react-router dev",
    "format": "prettier . --write",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest",
    "translate": "tsx scripts/translate.ts && prettier app/translations/*.ts --write",
    "typecheck": "react-router typegen && tsc",
    "upgrade": "npx npm-check-updates@latest --target minor -u"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@ianlucas/cs2-lib": "^9.1.0",
    "@ianlucas/cs2-lib-inspect": "^9.0.0",
    "@ianlucas/remix-auth-steam": "^8.0.1",
    "@prisma/client": "^7.10.0",
    "@react-router/fs-routes": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^17.4.2",
    "isbot": "^5.2.2",
    "lz-string": "^1.5.0",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "remix-auth": "^4.2.0",
    "remix-utils": "^10.0.0",
    "steamapi": "^3.1.5",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
