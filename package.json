  "devDependencies": {
    "@react-router/dev": "^7.18.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.2",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
